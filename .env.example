# Copy to .env and change EVERY value before sharing the environment. Never commit .env.

# --- PostgreSQL (platform metadata only: users, audit, simulations, recommendations, settings)
DB_NAME=cachedb
DB_USER=cacheadmin
DB_PASSWORD=change-me-db-password

# --- internal node-to-node authentication (shared secret sent with every node command)
CLUSTER_SECRET=change-me-cluster-secret-min-16-chars

# --- JWT signing key: at least 32 characters
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long

# --- initial accounts created on first start
ADMIN_PASSWORD=change-me-admin
OPERATOR_PASSWORD=change-me-operator
VIEWER_PASSWORD=change-me-viewer

# --- failure simulation: true ONLY in an isolated demo/test environment
SIMULATION_ENABLED=true

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
