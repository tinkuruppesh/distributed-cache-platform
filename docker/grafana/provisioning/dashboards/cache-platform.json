    {
     "refId": "C",
     "expr": "cluster_recovery_duration_seconds_max",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "recovery"
    }
   ],
   "fieldConfig": {
    "defaults": {
