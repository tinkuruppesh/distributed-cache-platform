   "options": {}
  },
  {
   "id": 15,
   "title": "Failover & recovery durations (max)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 21,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
